# Sunucuda kullanilacak ornek env dosyasi. Gercek degerler
# /opt/otosarj/packages/server/.env icinde tutulur, git'e girmez.
PORT=3001
OTOSARJ_DEMO_HMAC_SECRET=buraya-guclu-bir-secret-koy

# GUVENLIK (bkz. guvenlik incelemesi): CORS artik varsayilan olarak
# sinirsiz degil. Web arayuzunun calistigi origin'i (protokol+host,
# path olmadan) virgulle ayirarak buraya yazin. Bos birakilirsa sadece
# localhost dev origin'lerine izin verilir -- production'da MUTLAKA set edin.
CORS_ALLOWED_ORIGINS=https://otopriz.esadseyitoglu.xyz
